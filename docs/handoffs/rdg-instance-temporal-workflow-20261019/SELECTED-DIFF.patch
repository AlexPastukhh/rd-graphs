+            if command == 'init':
+                return subprocess.run(['python3','-B',str(w.home/'tools/rdg-authority.py'),'init',
+                    '--store',str(w.store),'--plan-capable'],text=True,capture_output=True,env=w.env)
+            return original_admin(command,payload,token)
+        w.admin = admin
