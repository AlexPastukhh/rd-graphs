          <mxGeometry x="65.000" y="990.000" width="1670.000" height="110.000" as="geometry" />
        </mxCell>
        <mxCell id="decompose-t61" value="Приоритет полезного разбиения" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="decompose-s60">
          <mxGeometry x="20.000" y="15.000" width="1630.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="decompose-t62" value="Если ценное сложное содержание даёт настоящие требуемые утверждения с самостоятельной пользой, предпочитаем под-R. Достаточная подробная R остаётся допустимой;" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="decompose-s60">
