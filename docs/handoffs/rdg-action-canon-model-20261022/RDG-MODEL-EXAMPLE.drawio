        <mxCell id="stalechain-t94" value="A-SERVICE сохранён для R2; смысл R-TRACK/R-SEC пригоден, цели ещё открыты." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="stalechain-s92">
