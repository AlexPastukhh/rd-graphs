        <mxCell id="ratt-s54" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#F7F8FC;strokeColor=none;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="920.000" y="702.000" width="320.000" height="30.480" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t55" value="Явный Action пересмотра" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="928.000" y="707.000" width="304.000" height="20.480" as="geometry" />
        </mxCell>
        <mxCell id="ratt-s56" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#3775CB;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="65.000" y="633.000" width="505.000" height="178.000" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t57" value="До пересмотра" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="ratt-s56">
          <mxGeometry x="20.000" y="15.000" width="465.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t58" value="R-ATT была принята как обязательная. Нельзя" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s56">
          <mxGeometry x="20.000" y="50.320" width="465.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t59" value="было просто не выбрать эту выходную R при" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s56">
          <mxGeometry x="20.000" y="72.080" width="465.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t60" value="выборе A-SERVICE." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s56">
          <mxGeometry x="20.000" y="93.840" width="465.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-s61" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#718096;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="1190.000" y="633.000" width="545.000" height="210.000" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t62" value="После принятого и закрытого A-NEED" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="ratt-s61">
          <mxGeometry x="20.000" y="15.000" width="505.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t63" value="В учебном примере необходимость отвергнута с" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s61">
          <mxGeometry x="20.000" y="50.320" width="505.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t64" value="основаниями и Evidence. Исход R-ATT: «не требуется»," style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s61">
          <mxGeometry x="20.000" y="72.080" width="505.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t65" value="а не «реализована»." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s61">
          <mxGeometry x="20.000" y="93.840" width="505.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-s66" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#3775CB;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="65.000" y="929.000" width="595.000" height="140.000" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t67" value="Что снято" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="ratt-s66">
          <mxGeometry x="20.000" y="15.000" width="555.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t68" value="Блокировка этой R снята. R1/R2 и A-SERVICE сами от этого" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s66">
          <mxGeometry x="20.000" y="50.320" width="555.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t69" value="не закрываются и не становятся ненужными." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s66">
          <mxGeometry x="20.000" y="72.080" width="555.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-s70" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BE4855;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="1135.000" y="929.000" width="600.000" height="140.000" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t71" value="Если R ещё нужна другому родителю" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="ratt-s70">
          <mxGeometry x="20.000" y="15.000" width="560.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t72" value="Одна локальная оценка не отменяет чужие требования. До" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s70">
          <mxGeometry x="20.000" y="50.320" width="560.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t73" value="общего исхода проверяется весь действующий объём" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s70">
          <mxGeometry x="20.000" y="72.080" width="560.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="ratt-t74" value="использования." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="ratt-s70">
          <mxGeometry x="20.000" y="93.840" width="560.000" height="21.760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
