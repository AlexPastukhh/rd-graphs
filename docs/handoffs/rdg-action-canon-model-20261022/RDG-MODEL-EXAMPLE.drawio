        </mxCell>
        <mxCell id="closure-t57" value="1. Нет открытых обязательных R" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="92.000" y="855.000" width="510.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="closure-t58" value="Проверяется весь актуальный объём и все" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="92.000" y="902.000" width="510.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="closure-t59" value="использования." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="92.000" y="925.040" width="510.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="closure-t60" value="2. Есть фактический результат" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="647.000" y="855.000" width="510.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="closure-t61" value="Готовность по зависимостям сама по себе не" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="647.000" y="902.000" width="510.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="closure-t62" value="доказательство." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="647.000" y="925.040" width="510.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="closure-t63" value="3. Отдельное закрытие A / R" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1202.000" y="855.000" width="510.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="closure-t64" value="Никакого автоматического закрытия родителя от" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1202.000" y="902.000" width="510.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="closure-t65" value="дочернего блока." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1202.000" y="925.040" width="510.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="closure-t66" value="«Не требуется» отличается от «достигнуто». Пустой список подцелей не равен выполнению. Новый объём не переписывает старые факты." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#BE4855;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="91.000" y="1020.000" width="1615.000" height="20.480" as="geometry" />
        </mxCell>
      </root>
