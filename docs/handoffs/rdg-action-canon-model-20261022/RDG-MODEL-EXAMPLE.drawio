        </mxCell>
        <mxCell id="canoncheck-s59" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#C66B40;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="960.000" y="625.000" width="740.000" height="190.000" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t60" value="Правила QRPE" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="canoncheck-s59">
          <mxGeometry x="20.000" y="15.000" width="700.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t61" value="Вопрос, риск или проблема связан с конкретным предметом проверки и" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s59">
          <mxGeometry x="20.000" y="50.320" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t62" value="основаниями. Видны существенные неизвестные и состояние. Finding не" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s59">
          <mxGeometry x="20.000" y="72.080" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t63" value="создаёт скрытое обязательство и не выбирает способ. Если нужна работа," style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s59">
          <mxGeometry x="20.000" y="93.840" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t64" value="её цель и Action оформляются явно. Если проблем не найдено, сохраняется" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s59">
          <mxGeometry x="20.000" y="115.600" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t65" value="объём проверки, а не выдуманная запись." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s59">
