          <mxGeometry x="1165.000" y="589.000" width="550.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t34" value="общее сходство тем." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1165.000" y="612.040" width="550.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-s35" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#D9E0EB;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="65.000" y="724.000" width="1670.000" height="139.000" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t36" value="Конкретно" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#8556BB;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="85.000" y="746.000" width="250.000" height="25.600" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t37" value="описанный случай" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#8556BB;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="85.000" y="771.600" width="250.000" height="25.600" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t38" value="Требуется работа в закрытой сети; доступ во внешнюю сеть" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#17263E;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="385.000" y="746.000" width="720.000" height="25.600" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t39" value="отсутствует." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#17263E;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="385.000" y="771.600" width="720.000" height="25.600" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t40" value="Сравнить с описанным случаем. Внутри канона нет ref" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1165.000" y="746.000" width="550.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t41" value="на конкретный рабочий owner." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1165.000" y="769.040" width="550.000" height="23.040" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-s42" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8556BB;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="65.000" y="915.000" width="800.000" height="178.000" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t43" value="Роль канона" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="canonmodes-s42">
          <mxGeometry x="20.000" y="15.000" width="760.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t44" value="Это показательная ситуация, а не факт проекта. Пример может быть общим или" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canonmodes-s42">
          <mxGeometry x="20.000" y="50.320" width="760.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t45" value="конкретным; локальные R/Context не являются ссылками на рабочие инстансы." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canonmodes-s42">
          <mxGeometry x="20.000" y="72.080" width="760.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-s46" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#3775CB;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="915.000" y="915.000" width="820.000" height="178.000" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t47" value="Граница сходства" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="canonmodes-s46">
          <mxGeometry x="20.000" y="15.000" width="780.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t48" value="Совпадение по смыслу, частичная связь, несовпадение и неизвестность" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canonmodes-s46">
          <mxGeometry x="20.000" y="50.320" width="780.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t49" value="различаются. Более слабое условие не подтверждает более сильное. Правила" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canonmodes-s46">
          <mxGeometry x="20.000" y="72.080" width="780.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canonmodes-t50" value="ANY/ALL не угадываются." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canonmodes-s46">
          <mxGeometry x="20.000" y="93.840" width="780.000" height="21.760" as="geometry" />
        </mxCell>
      </root>
