        <mxCell id="decompose-t56" value="Почему здесь нужны под-R" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="decompose-s55">
          <mxGeometry x="20.000" y="15.000" width="700.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="decompose-t57" value="У сохранности, доступа и понятности разные способы, проверки и" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="decompose-s55">
          <mxGeometry x="20.000" y="50.320" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="decompose-t58" value="состояния. Одно может быть готово раньше другого. Разбиение помогает" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="decompose-s55">
          <mxGeometry x="20.000" y="72.080" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="decompose-t59" value="вести реальную работу; родитель отдельно требует подтверждения." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="decompose-s55">
          <mxGeometry x="20.000" y="93.840" width="700.000" height="21.760" as="geometry" />
