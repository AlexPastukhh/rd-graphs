        </mxCell>
        <mxCell id="strength-t15" value="Жёсткая несовместимость" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="strength-s14">
          <mxGeometry x="20.000" y="15.000" width="770.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="strength-t16" value="R требует работы только в закрытой сети; рассматриваемый A обязательно" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s14">
          <mxGeometry x="20.000" y="50.320" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t17" value="отправляет данные наружу. Подтверждённое полное условие исключает A в этой" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s14">
          <mxGeometry x="20.000" y="72.080" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t18" value="ситуации. Плюсы несовместимость не компенсируют." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s14">
          <mxGeometry x="20.000" y="93.840" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-s19" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#BE7A12;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="925.000" y="190.000" width="810.000" height="370.000" as="geometry" />
        </mxCell>
        <mxCell id="strength-t20" value="Мягкий довод против" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="strength-s19">
          <mxGeometry x="20.000" y="15.000" width="770.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="strength-t21" value="Команда плохо знает инструмент, необходимый для A. Это повышает цену и риск," style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s19">
          <mxGeometry x="20.000" y="50.320" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t22" value="но допускает обоснованный выбор с сохранением минуса и мер работы с ним." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s19">
          <mxGeometry x="20.000" y="72.080" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-s23" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8556BB;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="65.000" y="630.000" width="810.000" height="300.000" as="geometry" />
        </mxCell>
        <mxCell id="strength-t24" value="Логическая группа" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="strength-s23">
          <mxGeometry x="20.000" y="15.000" width="770.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="strength-t25" value="Для AND сопоставляется вся группа. Совпадение одного элемента не означает" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s23">
          <mxGeometry x="20.000" y="50.320" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t26" value="выполнение полного условия. OR допускает оба совпадения. Сила относится к" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s23">
          <mxGeometry x="20.000" y="72.080" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t27" value="доводу относительно A." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s23">
          <mxGeometry x="20.000" y="93.840" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-s28" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#278C81;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="925.000" y="630.000" width="810.000" height="300.000" as="geometry" />
        </mxCell>
        <mxCell id="strength-t29" value="Доказанность отдельно" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="strength-s28">
          <mxGeometry x="20.000" y="15.000" width="770.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="strength-t30" value="Совпало, частично связано, не совпало и неизвестно - разные результаты. Hard не" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s28">
          <mxGeometry x="20.000" y="50.320" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t31" value="превращает предположение в факт. Сопоставление не выбирает и не исполняет A" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s28">
          <mxGeometry x="20.000" y="72.080" width="770.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="strength-t32" value="автоматически." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="strength-s28">
          <mxGeometry x="20.000" y="93.840" width="770.000" height="21.760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
