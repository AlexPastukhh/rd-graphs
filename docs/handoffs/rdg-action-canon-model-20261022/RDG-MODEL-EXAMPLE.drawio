        <mxCell id="canoncheck-t53" value="Правила сопоставления" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="canoncheck-s52">
          <mxGeometry x="20.000" y="15.000" width="700.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t54" value="Канон - самодостаточный показательный граф. Ситуация A содержит" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s52">
          <mxGeometry x="20.000" y="50.320" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t55" value="реальные относящиеся R и инстансы Context. Сравнение по смыслу, группе" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s52">
          <mxGeometry x="20.000" y="72.080" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t56" value="или свойству обосновывается. Частичное сходство и неизвестность не" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s52">
          <mxGeometry x="20.000" y="93.840" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t57" value="объявляются полным совпадением. AND/OR и аргументы против видны" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s52">
          <mxGeometry x="20.000" y="115.600" width="700.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="canoncheck-t58" value="явно." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="canoncheck-s52">
