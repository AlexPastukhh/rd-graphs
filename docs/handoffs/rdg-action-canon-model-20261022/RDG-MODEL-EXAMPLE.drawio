        <mxCell id="closure-t56" value="Правило перехода - это не уже произошедшие события" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="1">
