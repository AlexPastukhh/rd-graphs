        <mxCell id="awaive-t70" value="Отдельный исход R-ATT" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="awaive-s69">
          <mxGeometry x="20.000" y="15.000" width="490.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t71" value="В этом эпизоде проверка дала результат «не" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="awaive-s69">
          <mxGeometry x="20.000" y="50.320" width="490.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t72" value="требуется». Если потребность подтверждается, R" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="awaive-s69">
          <mxGeometry x="20.000" y="72.080" width="490.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t73" value="остаётся обязательной и для неё выбирают" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="awaive-s69">
          <mxGeometry x="20.000" y="93.840" width="490.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t74" value="реализацию." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="awaive-s69">
          <mxGeometry x="20.000" y="115.600" width="490.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="awaive-s75" style="shape=rectangle;rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#27814D;strokeWidth=1.5;dashed=0;dashPattern=6 4;container=0;" vertex="1" parent="1">
          <mxGeometry x="641.000" y="850.000" width="1094.000" height="225.000" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t76" value="Что подтверждено" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#17263E;resizable=1;" vertex="1" parent="awaive-s75">
          <mxGeometry x="20.000" y="15.000" width="1054.000" height="24.320" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t77" value="Исследованы потребности R1/R2 и все использования цели. E-ATT относится к согласованному объёму v1;" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="awaive-s75">
          <mxGeometry x="20.000" y="50.320" width="1054.000" height="21.760" as="geometry" />
        </mxCell>
        <mxCell id="awaive-t78" value="отсутствие файлов сейчас само по себе не доказывает их ненужность. Action проверки выбран и отдельно закрыт." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#58677D;resizable=1;" vertex="1" parent="awaive-s75">
          <mxGeometry x="20.000" y="72.080" width="1054.000" height="21.760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
