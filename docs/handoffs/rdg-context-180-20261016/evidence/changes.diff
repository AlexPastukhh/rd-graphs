--- before/tests/rdg-state-boundaries.test.cjs
+++ after/tests/rdg-state-boundaries.test.cjs
@@ -0,0 +1,29 @@
+const {test}=require('node:test'),assert=require('node:assert/strict');
+const core=require('../tools/rdg-state.js');
+function input(){
+ const graph={id:'g',identitySpace:'project',contextFields:[{id:'f',title:'Field',explanation:'Meaning'}],contextFieldsComplete:true,
+ contextUses:[{fieldRef:{graphSlug:'g',fieldId:'f'},purpose:'Use'}],nodes:[
+ {id:'C',kind:'context',title:'Answer',contextFieldRef:{graphSlug:'g',fieldId:'f'},contextAnswers:[{id:'T1',value:'Earlier',source:'User',recordedAt:'2026-10-01',effectiveAt:'2026-10-01',scope:'project'}]}]};
+ return {graph,items:[{slug:'g',group:'workspaces',graph}]};
+}
+test('future, scope mismatch and as-of history are distinct; no silently reused obsolete revision',()=>{
+ const {graph,items}=input(),answer=graph.nodes[0].contextAnswers[0],read=()=>core.collect({items,graphSlug:'g',asOf:'2026-10-16'}).fields[0];
+ answer.effectiveAt='2026-11-01';assert.equal(read().answers[0].status,'future');assert.equal(read().answerStatus,'needs-assessment');
+ answer.effectiveAt='2026-10-01';answer.scope='branch/a';assert.equal(read().answers[0].status,'scope-needs-assessment');
+ answer.scope='project';graph.nodes[0].contextAnswers.push({...answer,id:'T2',value:'Not known yet',recordedAt:'2026-11-01'});
+ assert.equal(read().answers[0].value,'Earlier');
+ graph.nodes[0].contextAnswers.at(-1).recordedAt='2026-10-15';graph.nodes[0].contextAnswers.at(-1).validUntil='2026-10-15';
+ assert.equal(read().answers[0].status,'expired');
+});
+test('invalid calendar date and unscoped answer owner are rejected; unavailable condition remains unknown',()=>{
+ const {graph,items}=input();graph.nodes[0].contextAnswers[0].recordedAt='2026-02-31';assert.throws(()=>core.validate(items),/answer needs/);
+ graph.nodes[0].contextAnswers[0].recordedAt='2026-10-01';delete graph.identitySpace;assert.throws(()=>core.validate(items),/project-scoped/);
+ graph.identitySpace='project';graph.contextUses[0].when={allSelected:[{graphSlug:'unavailable',optionId:'O'}]};
+ assert(core.validate(items,{partial:true}));assert.throws(()=>core.validate(items),/unavailable/);
+ const r=core.collect({items,graphSlug:'g'});assert.equal(r.fields[0].state,'unknown');assert.equal(r.fields[0].question,false);
+});
+test('multiple conditions retain all consumers; one current usage wins without merging definitions by name',()=>{
+ const {graph,items}=input();graph.nodes.push({id:'O',kind:'option',title:'Option'});
+ graph.contextUses.push({fieldRef:{graphSlug:'g',fieldId:'f'},purpose:'Only after selection',when:{allSelected:[{graphSlug:'g',optionId:'O'}]}});
+ const r=core.collect({items,graphSlug:'g'}).fields[0];assert.equal(r.usages.length,2);assert.equal(r.state,'now');assert(r.usages.some(u=>u.state==='later'));
+});
--- before/tests/rdg-state-viewer.test.cjs
+++ after/tests/rdg-state-viewer.test.cjs
@@ -0,0 +1,50 @@
+const {test}=require('node:test'),assert=require('node:assert/strict');
+const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),vm=require('node:vm');
+const {simulate}=require('./viewer-test-helper.cjs'),core=require('../tools/rdg-state.js');
+const ROOT=path.resolve(__dirname,'..');
+const snapshot={};vm.runInNewContext(fs.readFileSync(path.join(ROOT,'tools/rd-graph-data.js'),'utf8'),snapshot);
+const manifest=JSON.parse(JSON.stringify(snapshot.RDG_EMBEDDED_GRAPHS));
+const get=()=>core.collect({items:manifest.graphs,manifest,setId:'context-working',asOf:'2026-10-16'});
+test('set aggregation includes hidden branch, reuses prepared definitions and earlier project answer',()=>{
+ const r=get(),access=r.fields.find(f=>f.fieldRef.fieldId==='accessibility'),later=r.fields.find(f=>f.fieldRef.fieldId==='alternative-details');
+ assert.equal(access.answerStatus,'known');assert.equal(access.usages.length,4);assert.equal(access.state,'now');
+ assert.equal(later.state,'later');assert.equal(later.question,false);assert.equal(access.fieldRef.graphSlug,'context-prepared-root');
+ assert(r.incomplete.some(i=>i.reason==='canon-fields-incomplete'));
+ assert(r.fields.find(f=>f.fieldRef.fieldId==='delivery').nextAction==='assess-existing-records');
+ const child=core.collect({items:manifest.graphs,manifest,graphSlug:'context-working-alternative'});
+ assert(child.fields.every(f=>f.state==='later'),'opening alternative does not make its fields current');
+});
+test('CLI and embedded Viewer consume the same core and report equivalent fields',async()=>{
+ const u=simulate({useBundle:true});await u.flush();await u.openSet('context-working');
+ const r=cp.spawnSync('python3',[path.join(ROOT,'tools/rdg-context.py'),'--fields','--set-id','context-working','--as-of',new Date().toISOString().slice(0,10)],{encoding:'utf8'});
+ assert.equal(r.status,0,r.stderr);
+ assert.deepEqual(JSON.parse(JSON.stringify(u.host.rdgState.list())),JSON.parse(r.stdout));
+ const code=fs.readFileSync(path.join(ROOT,'tools/rd-graph-viewer.user.js'),'utf8'),shared=fs.readFileSync(path.join(ROOT,'tools/rdg-state.js'),'utf8');
+ assert(code.includes('// BEGIN GENERATED RDG STATE\n'+shared+'// END GENERATED RDG STATE'));
+});
+test('context mode inspects without navigation, aggregate stays clickable, off restores navigation',async()=>{
+ const u=simulate({useBundle:true});await u.flush();await u.openSet('context-working');const key=u.host.rdgLayout.graphKey(),before=u.host.rdgLayout.getDocument();
+ assert.equal(u.root.querySelectorAll('.node').length,2,'alternative is hidden');
+ assert(u.root.getElementById('context-summary'));
+ u.ids['context-mode'].onclick();
+ const n=u.root.querySelectorAll('.node').find(n=>n.getAttribute('data-id')==='context-working-current');
+ n.listeners.click({stopPropagation(){}});await u.flush();
+ assert.equal(u.host.rdgLayout.graphKey(),key);assert(u.info().includes('Поля графа: context-working-current'));assert(u.info().includes('ответ известен'));
+ u.root.getElementById('context-summary').listeners.click({stopPropagation(){}});
+ assert(u.info().includes('После выбора ветки'));assert(u.info().includes('Теория')||u.info().includes('W3C'));assert(u.info().includes('НЕПОЛНЫЙ'));
+ assert.deepEqual(u.host.rdgLayout.getDocument(),before,'inspection is read-only');
+ u.ids['context-mode'].onclick();n.listeners.click({stopPropagation(){}});await u.flush();
+ assert.notEqual(u.host.rdgLayout.graphKey(),key);u.ids['context-fields'].onclick();assert(u.info().includes('Контекст графа'));
