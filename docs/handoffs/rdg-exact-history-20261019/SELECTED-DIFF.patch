+            "graphs": [{"graphFile": REL, "identitySpace": "temporal-demo",
+                        "revision": 1, "snapshotSHA256": OWNER.digest(self.graph)}],
+            "scenario": {"branchId": "B-RESULT", "outcome": "positive"}}
