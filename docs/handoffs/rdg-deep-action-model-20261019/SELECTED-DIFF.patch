+# Completion is a separate fact/projection; candidate/selected are choice states.
+COMPLETION_EVENTS = {"action_executed", "requirement_achieved"}
+
+
+def completion_digest(value):
+    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True,
+                                     separators=(",", ":")).encode("utf-8")).hexdigest()
+
+
+def completion_state(g):
+    """Current local composition. Potential paths and unavailable owners fail closed.
+
+    subgoal contributes to the parent R; method_correctness to the Action.
+    Empty children never prove a leaf result. History remains immutable when a
+    later edit changes this projection.
+    """
+    nodes = {n["id"]: n for n in g["nodes"]}
+    edges = [e for e in g["edges"] if e.get("archived") is not True]
+    inactive = lambda n: n.get("active") is False or n.get("status") in {
+        "inactive", "superseded", "rejected"}
+    root = nodes.get(g.get("rootRequirementId"), {})
+    actual = {root.get("id")} if root and not inactive(root) and not root.get("projectionOf") and root.get("status") not in {"candidate", "potential"} else set()
+    for _ in range(len(nodes)):
+        old = set(actual)
+        for e in edges:
+            if e["from"] not in actual or inactive(nodes[e["from"]]) or nodes[e["from"]].get("projectionOf"):
+                continue
+            if e["type"] == "DERIVES" and e["from"] in actual:
+                actual.add(e["to"])
+            if e["type"] == "DRIVES" and e["from"] in actual:
+                a = nodes.get(e["to"], {})
+                if a.get("kind") == "action" and a.get("status") == "selected" and not inactive(a):
+                    actual.add(a["id"])
+            if e["type"] == "INTRODUCES" and e["from"] in actual:
+                actual.add(e["to"])
+        if actual == old:
+            break
+    cache, visiting = {}, set()
+
+    def selected(action, driver):
+        basis = action.get("selectionBasis") or {}
+        events = [e for e in g["events"] if e.get("type") == "action_selected" and e.get("actionId") == action["id"]]
+        return (action.get("status") == "selected" and
+                basis.get("actionSnapshot", {}).get("id") == action["id"] and
+                basis.get("actionSnapshot", {}).get("status") == "candidate" and
+                basis.get("driverSnapshot", {}).get("id") == driver and
+                len(events) == 1 and events[0].get("driverRequirementId") == driver)
+
+
+    def evaluate(nid):
+        if nid in cache:
+            return cache[nid]
+        ensure(nid not in visiting, "completion dependency cycle")
+        visiting.add(nid)
+        n = nodes[nid]
+        outgoing = [e for e in edges if e["from"] == nid]
+        dependencies = []
+        if n["kind"] == "action":
+            dependencies = [e for e in outgoing if e["type"] == "INTRODUCES" and
+                            e.get("childRole") == "method_correctness"]
+        elif n["kind"] == "requirement":
+            chosen = [e for e in outgoing if e["type"] == "DRIVES" and
+                      nodes[e["to"]].get("kind") == "action" and
+                      selected(nodes[e["to"]], nid)]
+            dependencies = list(chosen)
+            for drive in chosen:
+                dependencies.extend(e for e in edges if e["from"] == drive["to"] and
+                                    e["type"] == "INTRODUCES" and e.get("childRole") == "subgoal")
+        cause_ids = {nid} if n["kind"] == "action" else {
+            e["to"] for e in outgoing if e["type"] == "DRIVES" and
+            nodes[e["to"]].get("kind") == "action" and selected(nodes[e["to"]], nid)}
+        unknown_roles = [e for e in edges if e["type"] == "INTRODUCES" and
+                         e["from"] in cause_ids and e.get("childRole") not in CHILD_ROLES]
+        children = [(e, evaluate(e["to"])) for e in dependencies]
+        # Annotation changes do not erase completed work. Normative definition,
+        # selected composition and dependency results do participate in the pin.
+        annotation = {"qrpe", "canonBlock", "selectionBasis", "contextAnnotationHistory",
+                      "x", "y", "layout", "presentation"}
+        material = {k: copy.deepcopy(v) for k, v in n.items() if k not in annotation}
+        basis = {"node": material, "dependencies": [
+            {"edge": copy.deepcopy(e), "basisSHA256": row["basisSHA256"]}
+            for e, row in sorted(children, key=lambda pair: pair[0]["id"])]}
+        signature = completion_digest(basis)
+        recorded = next((e for e in reversed(g["events"]) if
+                        e.get("type") in COMPLETION_EVENTS and e.get("targetId") == nid and
+                        e.get("basisSHA256") == signature), None)
+        normative = lambda node: {key: node.get(key) for key in (
+            "title", "description", "definition", "requirementText", "currentStatement", "scope")}
+        definition_changed = False
+        if n["kind"] == "action" and children:
+            old_definition = (n.get("selectionBasis") or {}).get("actionSnapshot", {})
+            definition_changed = normative(n) != normative(old_definition)
+        elif n["kind"] == "requirement" and children:
+            definition_changed = any(normative(n) != normative(
+                nodes[aid].get("selectionBasis", {}).get("driverSnapshot", {})) for aid in cause_ids)
+        available = (nid in actual and not inactive(n) and not n.get("projectionOf") and
+                     n.get("status") not in {"candidate", "potential"})
+        if not available:
+            complete, reason = False, "potential-inactive-or-unavailable-owner"
+        elif unknown_roles:
+            complete, reason = False, "unknown-required-child-role"
+        elif children:
+            complete = all(row["complete"] for _, row in children)
+            reason = "dependencies-complete" if complete else "required-work-incomplete"
+            if complete and definition_changed and not (recorded and recorded.get("completionMode") == "explicit"):
+                complete, reason = False, "definition-changed-result-review"
+        else:
+            complete = recorded is not None and recorded.get("completionMode") == "explicit"
+            reason = "recorded-result" if complete else "result-not-recorded"
+        result = {"nodeId": nid, "kind": n["kind"], "complete": complete,
+                  "reason": reason, "basisSHA256": signature, "basis": basis,
+                  "dependencyIds": [e["to"] for e, _ in children],
+                  "eventId": recorded["id"] if recorded and complete else None}
+        cache[nid] = result
+        visiting.remove(nid)
+        return result
+    for n in g["nodes"]:
+        if n["kind"] in {"requirement", "action"}:
+            evaluate(n["id"])
+    return cache
+
+
+def validate_completion_event(event, nodes):
+    target = nodes.get(event.get("targetId"))
+    expected = "action" if event.get("type") == "action_executed" else "requirement"
+    ensure(target and target.get("kind") == expected and
+           event.get("completionMode") in {"explicit", "derived"} and
+           isinstance(event.get("basis"), dict) and
+           completion_digest(event["basis"]) == event.get("basisSHA256") and
+           event["basis"].get("node", {}).get("id") == target["id"] and
+           isinstance(event.get("recordedAt"), str) and event["recordedAt"] and
+           isinstance(event.get("authorityPrincipal"), str) and event["authorityPrincipal"],
+           "invalid completion history event")
+
+
+def append_derived_completion(g, trigger):
+    """Record newly satisfied composites once, retaining past scope snapshots."""
+    if g.get("actionModel") != "candidate-v6":
+        return
+    for row in completion_state(g).values():
+        if not row["complete"] or row["eventId"]:
+            continue
+        event = {"id": "completion-" + completion_digest({
+                    "trigger": trigger["id"], "target": row["nodeId"],
+                    "basis": row["basisSHA256"]})[:32],
+                 "type": "action_executed" if row["kind"] == "action" else "requirement_achieved",
+                 "targetId": row["nodeId"], "completionMode": "derived",
+                 "basis": row["basis"], "basisSHA256": row["basisSHA256"],
+                 "by": trigger["by"], "note": "Обязательная работа выбранной композиции выполнена",
+                 "authorityPrincipal": trigger["authorityPrincipal"],
+                 "recordedAt": trigger["recordedAt"], "triggerEventId": trigger["id"]}
+        if "verifiedTrustReceipt" in trigger:
+            event["verifiedTrustReceipt"] = copy.deepcopy(trigger["verifiedTrustReceipt"])
+        g["events"].append(event)
+
+
+def record_completion(g, operation):
+    from datetime import datetime, timezone
+    expected = "action" if operation["op"] == "record_action_execution" else "requirement"
+    nid = operation.get("targetId")
+    n = next((n for n in g["nodes"] if n["id"] == nid), None)
+    ensure(n and n["kind"] == expected, "completion target kind mismatch")
+    row = completion_state(g)[nid]
+    ensure(row["reason"] != "potential-inactive-or-unavailable-owner", "completion requires actual selected scope")
+    ensure(not row["complete"], "completion already recorded or derived")
+    ensure(row["reason"] in {"result-not-recorded", "definition-changed-result-review"},
+           "required work must be completed first; unknown roles cannot be bypassed")
+    if n.get("actionType") == "decomposition":
+        ensure(any(e["type"] == "INTRODUCES" and e["from"] == nid and
+                   e.get("childRole") == "subgoal" and e.get("archived") is not True
+                   for e in g["edges"]), "decomposition has no introduced subgoals")
+    event = copy.deepcopy(operation.get("event"))
+    event_type = "action_executed" if expected == "action" else "requirement_achieved"
+    ensure(isinstance(event, dict) and event.get("type") == event_type and
+           event.get("targetId") == nid and event.get("by") in {"user", "assistant"} and
+           isinstance(event.get("note"), str) and event["note"].strip() and
+           isinstance(event.get("id"), str) and event["id"] and
+           all(e["id"] != event["id"] for e in g["events"]) and
+           isinstance(event.get("authorityPrincipal"), str) and event["authorityPrincipal"],
+           "completion needs unique attributed event and result note")
+    ensure(not {"basis", "basisSHA256", "completionMode", "recordedAt", "triggerEventId"}.intersection(event),
+           "completion basis and recording time belong to writer")
+    event.update({"basis": row["basis"], "basisSHA256": row["basisSHA256"],
+                  "completionMode": "explicit",
+                  "recordedAt": datetime.now(timezone.utc).isoformat()})
+    g["events"].append(event)
+    append_derived_completion(g, event)
 
 
