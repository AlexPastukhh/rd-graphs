# Separate G4 candidate build. No G2 CLI, Docker socket, or owner state.
# This image can GET SonarCloud. POST is blocked in the G4 candidate.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/fortis
COPY fortis_approvals/requirements-owner.txt /opt/requirements-owner.txt
RUN python -m pip install --disable-pip-version-check --no-cache-dir -r /opt/requirements-owner.txt && \
    groupadd -g 10001 fortis && useradd --no-log-init -u 10001 -g 10001 -M -s /usr/sbin/nologin fortis
RUN mkdir -p /opt/fortis/fortis_approvals /state /run/g4-token
COPY fortis_approvals/__init__.py fortis_approvals/core.py fortis_approvals/owner_auth.py fortis_approvals/owner_portal.py fortis_approvals/synthetic.py fortis_approvals/runtime.py fortis_approvals/server.py fortis_approvals/sonar.py fortis_approvals/sonar_inventory.py fortis_approvals/g4_candidate.py fortis_approvals/g4_server.py fortis_approvals/g4_operator.py fortis_approvals/g4_secret_bootstrap.py fortis_approvals/g4_volume_repair.py /opt/fortis/fortis_approvals/
COPY fortis_approvals/static /opt/fortis/fortis_approvals/static
USER 10001:10001
EXPOSE 18991
CMD ["python","-m","fortis_approvals.g4_server"]
