# One-shot G4 GET-only Issue preflight; no G2, receipts, tokens, config or ports.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/fortis
RUN mkdir -p /opt/fortis/fortis_approvals
COPY fortis_approvals/__init__.py fortis_approvals/core.py fortis_approvals/sonar.py fortis_approvals/sonar_inventory.py fortis_approvals/sonar_preflight.py /opt/fortis/fortis_approvals/
USER 10001:10001
ENTRYPOINT ["python", "-m", "fortis_approvals.sonar_preflight"]
