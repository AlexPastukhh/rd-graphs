# R4 OFFLINE CHECK ONLY. Disposable test image; NOT a Fortis deployment.
# Exact allowlisted modules, no volume/ports/secret provisioning and no API
# credentials. DO NOT promote this image into the owner Windows runtime.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/r4
RUN groupadd -g 10001 r4check && useradd --no-log-init -u 10001 -g 10001 -M -s /usr/sbin/nologin r4check
COPY fortis_approvals/__init__.py fortis_approvals/core.py fortis_approvals/repo_action_contract.py fortis_approvals/repo_ingress.py fortis_approvals/sonar.py fortis_approvals/sonar_inventory.py fortis_approvals/sonar_read.py /opt/r4/fortis_approvals/
COPY fortis_approvals/tests/test_r4_read_image_smoke.py /opt/r4/tests/
USER 10001:10001
CMD ["python","-B","-m","unittest","discover","-s","tests","-p","test_r4_read_image_smoke.py","-v"]
